#include <windows.h>
#include "../src/resource.h"
#include "version.h"

// ASCII only, so the .rc needs no code-page pragma to compile identically
// under both the MSVC and the MinGW resource compilers.

IDI_APP     ICON         "icon.ico"
1           RT_MANIFEST  "app.manifest"

// The manager UI is embedded, so the program stays a single self-contained
// executable with nothing to copy alongside it.
IDR_UI_HTML RCDATA       "../ui/index.html"

// Built-in stickers: a layer can use one instead of a file from the disk.
IDR_STICKER_OUTNET RCDATA "stickers/out-net.png"
IDR_STICKER_WIFREE RCDATA "stickers/wifree.png"

VS_VERSION_INFO VERSIONINFO
  FILEVERSION     FLOATY_VERSION_RC
  PRODUCTVERSION  FLOATY_VERSION_RC
  FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
  FILEFLAGS       0
  FILEOS          VOS_NT_WINDOWS32
  FILETYPE        VFT_APP
  FILESUBTYPE     VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "tsoolgee"
      VALUE "FileDescription",  "Floaty - floating image overlays"
      VALUE "FileVersion",      FLOATY_VERSION_STR
      VALUE "InternalName",     "Floaty"
      VALUE "OriginalFilename", "Floaty.exe"
      VALUE "ProductName",      "Floaty"
      VALUE "ProductVersion",   FLOATY_VERSION_STR
      VALUE "LegalCopyright",   "MIT License"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
